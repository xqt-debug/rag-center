RAG_ENV=development
# 测试登录账号，仅 development 环境生效。
RAG_DEV_USERNAME=admin
RAG_DEV_PASSWORD=admin123
RAG_DATABASE_URL=postgresql+psycopg://rag:rag@127.0.0.1:5432/rag
RAG_STORAGE_DIR=./data/files
RAG_PUBLIC_URL=http://localhost:8000
# 生产环境必须设置：请生成至少 32 个字符的随机密钥。
RAG_SECRET=development-only-change-before-deploying
RAG_SMS_PROVIDER=development
# 验证码接口仅在开发环境返回测试验证码；生产环境必须接入 HTTPS 短信网关。
RAG_SMS_WEBHOOK_URL=
RAG_SMS_WEBHOOK_TOKEN=
# 真实向量索引必须配置 API 密钥；local-test 仅供显式选择的自动化测试使用。
RAG_EMBEDDING_PROVIDER=openai-compatible
RAG_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
RAG_EMBEDDING_API_KEY=
RAG_EMBEDDING_MODEL=text-embedding-v4
RAG_EMBEDDING_DIMENSIONS=1024
RAG_MAX_FILE_MB=20
RAG_STORAGE_QUOTA_MB=200
RAG_MAX_DOCUMENTS=200
