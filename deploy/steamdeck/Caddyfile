{
	# DNS-01 needs no inbound HTTP port. Do not log signed transfer URLs.
	auto_https disable_redirects
}

{$RAG_DOMAIN:rag.xqtdevelopment.xyz} {
	tls {
		dns alidns {
			access_key_id {env.ALIYUN_ACCESS_KEY_ID}
			access_key_secret {env.ALIYUN_ACCESS_KEY_SECRET}
		}
		resolvers 223.5.5.5 1.1.1.1
	}

	# Flush streaming MCP responses immediately; keep the original Host header.
	reverse_proxy api:8000 {
		flush_interval -1
	}
}
